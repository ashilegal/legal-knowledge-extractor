{
  "$defs": {
    "Basis": {
      "enum": [
        "source",
        "interpretation"
      ],
      "title": "Basis",
      "type": "string"
    },
    "CaseFields": {
      "properties": {
        "case_name": {
          "title": "Case Name",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "court": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parties": {
          "items": {
            "$ref": "#/$defs/Party"
          },
          "title": "Parties",
          "type": "array"
        },
        "material_facts": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Material Facts",
          "type": "array"
        },
        "legal_issues": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Legal Issues",
          "type": "array"
        },
        "laws": {
          "items": {
            "$ref": "#/$defs/LawRef"
          },
          "title": "Laws",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Statement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "principles": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Principles",
          "type": "array"
        },
        "important_factors": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Important Factors",
          "type": "array"
        },
        "related": {
          "items": {
            "$ref": "#/$defs/RelatedRef"
          },
          "title": "Related",
          "type": "array"
        }
      },
      "required": [
        "case_name"
      ],
      "title": "CaseFields",
      "type": "object"
    },
    "DateValue": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "default": "year",
          "enum": [
            "year",
            "month",
            "day"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "EvidenceRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "char_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Span"
        }
      },
      "required": [
        "id",
        "doc_id",
        "pages"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Flags": {
      "properties": {
        "proprietary": {
          "default": false,
          "title": "Proprietary",
          "type": "boolean"
        },
        "low_ocr_confidence": {
          "default": false,
          "title": "Low Ocr Confidence",
          "type": "boolean"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "title": "Flags",
      "type": "object"
    },
    "LawRef": {
      "properties": {
        "statute": {
          "title": "Statute",
          "type": "string"
        },
        "provision": {
          "default": "",
          "title": "Provision",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "quoted_provision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quoted Provision"
        }
      },
      "required": [
        "statute"
      ],
      "title": "LawRef",
      "type": "object"
    },
    "Party": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Party",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "extractor_version": {
          "default": "0.1.0",
          "title": "Extractor Version",
          "type": "string"
        },
        "prompt_version": {
          "default": "",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "RelatedRef": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "",
          "title": "Type",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "relation": {
          "default": "related_to",
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RelatedRef",
      "type": "object"
    },
    "Statement": {
      "description": "One independently worded point, tied to evidence.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "default": "source"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Statement",
      "type": "object"
    },
    "TopicRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "TopicRef",
      "type": "object"
    },
    "ValidationResult": {
      "properties": {
        "schema_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Ok"
        },
        "grounding_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounding Ok"
        },
        "terms_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Ok"
        },
        "overlap_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlap Ok"
        },
        "overlap_max_run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlap Max Run"
        },
        "overlap_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlap Ratio"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "title": "ValidationResult",
      "type": "object"
    }
  },
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "topic": {
      "anyOf": [
        {
          "$ref": "#/$defs/TopicRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subtopic": {
      "anyOf": [
        {
          "$ref": "#/$defs/TopicRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "flags": {
      "$ref": "#/$defs/Flags"
    },
    "validation": {
      "$ref": "#/$defs/ValidationResult"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_type": {
      "const": "CASE",
      "default": "CASE",
      "title": "Record Type",
      "type": "string"
    },
    "fields": {
      "$ref": "#/$defs/CaseFields"
    }
  },
  "required": [
    "record_id",
    "evidence",
    "fields"
  ],
  "title": "CaseRecord",
  "type": "object"
}